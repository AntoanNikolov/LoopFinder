# ---- Build outputs ----------------------------------------------------------
# Everything in build/ is generated by CMake and contains machine-specific
# absolute paths -- it MUST NEVER be committed.
build/
build-*/
cmake-build-*/
out/
Builds/

# ---- Third-party source (cloned by maintainers running CMake manually) -----
/JUCE/

# ---- IDE / editors ----------------------------------------------------------
.vscode/
.vs/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- Generated by CMake -----------------------------------------------------
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
compile_commands.json
*.o
*.obj
*.exe
*.dll
*.dylib
*.so
*.lib
*.a

# (Prebuilt/*/LoopFinder.plugin bundles ARE committed intentionally --- do not ignore them.)

# ---- Notes / scratch / local-only artefacts --------------------------------
.notes/
scratch/
*.log
loopfinder_screenshot*.png
