# ---- Build outputs ----------------------------------------------------------
# Everything in build/ is generated by CMake and contains machine-specific
# absolute paths -- it MUST NEVER be committed.
build/
build-*/
cmake-build-*/
out/
Builds/

# ---- Third-party source (fetched by the install scripts on first run) ------
# JUCE is downloaded into ./JUCE by Install LoopFinder.{bat,command}; we don't
# ship it in this repository.
/JUCE/

# ---- IDE / editors ----------------------------------------------------------
.vscode/
.vs/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- Generated by CMake -----------------------------------------------------
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
compile_commands.json
*.o
*.obj
*.exe
*.dll
*.dylib
*.so
*.lib
*.a

# ---- macOS bundles inadvertently checked in --------------------------------
*.vst3/
*.vst/
*.component/
*.app/

# ---- Notes / scratch / local-only artefacts --------------------------------
.notes/
scratch/
*.log
loopfinder_screenshot*.png
